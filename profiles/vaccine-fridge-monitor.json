{
  "name": "vaccine-fridge-monitor",
  "description": "Holds a vaccine fridge at 5 C by switching its cooler, and raises an alert the moment the temperature leaves the 2 to 8 C safe range. Keeps sampling often as the battery drains, since an unnoticed excursion costs more than a flat battery.",
  "topic": "cold-chain/fridge/temperature",
  "control": {
    "kind": "setpoint",
    "setpoint": 5.0,
    "hysteresis": 0.5,
    "cooling": true,
    "safe_band": 3.0
  },
  "power": {
    "active_secs": 60,
    "saver_secs": 300,
    "critical_secs": 900,
    "saver_below": 0.5,
    "critical_below": 0.2
  },
  "presentation": {
    "elements": [
      {
        "key": "fridge_temp",
        "unit": "celsius",
        "label": "Fridge temperature",
        "labels": {
          "fr": "Température du réfrigérateur",
          "sw": "Joto la friji"
        },
        "viz": "thermometer",
        "band": [
          2.0,
          8.0
        ],
        "stat": false,
        "scope": "always",
        "span": false
      },
      {
        "key": "cooler",
        "unit": "state",
        "label": "Cooler",
        "labels": {
          "fr": "Groupe froid",
          "sw": "Kipoza"
        },
        "viz": "switch",
        "stat": false,
        "scope": "always",
        "span": false,
        "state": "state.cooler_off"
      },
      {
        "key": "compressor_duty",
        "unit": "percent",
        "label": "Compressor duty",
        "labels": {
          "fr": "Cycle du compresseur",
          "sw": "Utendaji wa kompresa"
        },
        "viz": "bar",
        "band": [
          0.0,
          60.0
        ],
        "stat": true,
        "scope": "always",
        "span": false
      }
    ],
    "messages": {
      "state.cooler_off": {
        "en": "Off",
        "fr": "Arrêt",
        "sw": "Imezimwa"
      },
      "state.cooler_on": {
        "en": "Running",
        "fr": "En marche",
        "sw": "Inafanya kazi"
      }
    }
  }
}
