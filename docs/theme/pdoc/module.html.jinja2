{# The default module page, with the site's bar and its stylesheet loaded from the site root
   so a reader who followed a link in stays inside the site; custom.css beside this file
   carries the palette. #}
{% extends "default/module.html.jinja2" %}

{% block head %}
    {{ super() }}
    <script src="/js/reference.js" defer></script>
{% endblock %}

{% block module_contents %}
    {{ super() }}
    {% if not module.docstring and not module.flattened_own_members and module.submodules %}
        <section class="module-index">
            <h2>Submodules</h2>
            <dl>
                {% for submodule in module.submodules if is_public(submodule) | trim %}
                    <dt>{{ submodule.taken_from | link(text=submodule.modulename) }}</dt>
                    <dd>{{ submodule.docstring.split("\n\n")[0] | replace("\n", " ") }}</dd>
                {% endfor %}
            </dl>
        </section>
    {% endif %}
{% endblock %}
