{# The reference opens on the pamoja package itself, which is a namespace and so carries
   no docstring of its own. The generated landing takes that page's place; every other
   module renders as pdoc renders it. #}
{% extends "default/module.html.jinja2" %}

{% block module_info %}
    {{ super() }}
    {% if module.modulename == "pamoja" %}
        {% include "landing.html" %}
    {% endif %}
{% endblock %}
