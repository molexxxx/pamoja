{
  "name": "@pamoja/field-io",
  "version": "0.1.15",
  "description": "Field I/O: The wires a gateway actually has: framed serial packets, an RS485 request and the reply it draws, a CAN frame, and the address a chip answers on.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molexxxx/pamoja.git",
    "directory": "bindings/node/packages/field-io"
  },
  "homepage": "https://pamoja.molex.cloud/docs/install.html",
  "keywords": [
    "pamoja",
    "iot",
    "robotics",
    "field-io"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE-MIT"
  ],
  "engines": {
    "node": ">= 16"
  },
  "dependencies": {
    "@pamoja/can": "0.1.15",
    "@pamoja/gpio": "0.1.15",
    "@pamoja/modbus": "0.1.15",
    "@pamoja/serial": "0.1.15"
  }
}
