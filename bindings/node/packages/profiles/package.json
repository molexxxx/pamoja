{
  "name": "@pamoja/profiles",
  "version": "0.1.15",
  "description": "Profiles and robotics: A node instantiated by name with its policy and schedule, and the naming and encoding rules a robot's topics follow, with no ROS 2 or Zenoh installed.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molexxxx/pamoja.git",
    "directory": "bindings/node/packages/profiles"
  },
  "homepage": "https://pamoja.molex.cloud/docs/install.html",
  "keywords": [
    "pamoja",
    "iot",
    "robotics",
    "profiles"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE-MIT"
  ],
  "engines": {
    "node": ">= 16"
  },
  "dependencies": {
    "@pamoja/profile": "0.1.15",
    "@pamoja/ros2": "0.1.15",
    "@pamoja/zenoh": "0.1.15"
  }
}
