{
  "name": "@pamoja/native",
  "version": "0.1.14",
  "description": "The compiled pamoja engine for Node and the generated napi-rs contract every @pamoja package builds on. Installed as a dependency, not directly.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molexxxx/pamoja.git",
    "directory": "bindings/node/packages/native"
  },
  "homepage": "https://pamoja.molex.cloud/docs/",
  "keywords": [
    "pamoja",
    "iot",
    "robotics",
    "drones",
    "napi-rs"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "napi": {
    "binaryName": "pamoja-native",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "engines": {
    "node": ">= 16"
  }
}
