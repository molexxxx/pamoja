{
  "name": "@pamoja/core",
  "version": "0.1.14",
  "description": "Node.js bindings for the pamoja device SDK core.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molexxxx/pamoja.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mqtt": {
      "types": "./dist/mqtt.d.ts",
      "default": "./dist/mqtt.js"
    },
    "./security": {
      "types": "./dist/security.d.ts",
      "default": "./dist/security.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "default": "./dist/codec.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "default": "./dist/kit.js"
    },
    "./raw": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "napi": {
    "binaryName": "pamoja-core",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "files": [
    "index.js",
    "index.d.ts",
    "dist/"
  ],
  "engines": {
    "node": ">= 16"
  },
  "scripts": {
    "build": "napi build --platform --release && tsc -p tsconfig.json",
    "build:native": "napi build --platform --release",
    "build:debug": "napi build --platform && tsc -p tsconfig.json",
    "build:facade": "tsc -p tsconfig.json",
    "test": "node test.js",
    "prepack": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.0",
    "@types/node": "^26.1.0",
    "typescript": "^7.0.2"
  }
}
