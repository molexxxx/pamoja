<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Pamoja.Zenoh</PackageId>
    <AssemblyName>Pamoja.Zenoh</AssemblyName>
    <RootNamespace>Pamoja.Zenoh</RootNamespace>
    <Description>Zenoh key expressions: validity, canonical form, and wildcard matching.</Description>
    <PackageTags>pamoja;iot;robotics;zenoh</PackageTags>
    <PackageProjectUrl>https://pamoja.molex.cloud/docs/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pamoja.Native/Pamoja.Native.csproj" />
  </ItemGroup>

</Project>
