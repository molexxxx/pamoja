<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Pamoja.Ladder</PackageId>
    <AssemblyName>Pamoja.Ladder</AssemblyName>
    <RootNamespace>Pamoja.Ladder</RootNamespace>
    <Description>Cheapest reachable link first, buffering to a store when every link is down.</Description>
    <PackageTags>pamoja;iot;robotics;ladder</PackageTags>
    <PackageProjectUrl>https://pamoja.molex.cloud/docs/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pamoja.Core/Pamoja.Core.csproj" />
    <ProjectReference Include="../Pamoja.Native/Pamoja.Native.csproj" />
    <ProjectReference Include="../Pamoja.Sync/Pamoja.Sync.csproj" />
  </ItemGroup>

</Project>
