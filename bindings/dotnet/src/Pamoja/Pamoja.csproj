    <ProjectReference Include="../Pamoja.Coap/Pamoja.Coap.csproj" />
    <ProjectReference Include="../Pamoja.Codec/Pamoja.Codec.csproj" />
    <ProjectReference Include="../Pamoja.Core/Pamoja.Core.csproj" />
    <ProjectReference Include="../Pamoja.Gpio/Pamoja.Gpio.csproj" />
    <ProjectReference Include="../Pamoja.Kit/Pamoja.Kit.csproj" />
    <ProjectReference Include="../Pamoja.Ladder/Pamoja.Ladder.csproj" />
    <ProjectReference Include="../Pamoja.Loopback/Pamoja.Loopback.csproj" />
    <ProjectReference Include="../Pamoja.Lora/Pamoja.Lora.csproj" />
    <ProjectReference Include="../Pamoja.Lorawan/Pamoja.Lorawan.csproj" />
    <ProjectReference Include="../Pamoja.Mavlink/Pamoja.Mavlink.csproj" />
    <ProjectReference Include="../Pamoja.Mesh/Pamoja.Mesh.csproj" />
    <ProjectReference Include="../Pamoja.Modbus/Pamoja.Modbus.csproj" />
    <ProjectReference Include="../Pamoja.Mqtt/Pamoja.Mqtt.csproj" />
