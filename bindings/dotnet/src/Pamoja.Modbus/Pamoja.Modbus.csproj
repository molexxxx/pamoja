<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Pamoja.Modbus</PackageId>
    <AssemblyName>Pamoja.Modbus</AssemblyName>
    <RootNamespace>Pamoja.Modbus</RootNamespace>
    <Description>Modbus RTU for RS485 field devices: a client that polls them over a serial port with the line's timing, simulated devices that answer as real ones do, and the frames with their CRC-16/MODBUS.</Description>
    <PackageTags>pamoja;iot;robotics;modbus</PackageTags>
    <PackageProjectUrl>https://pamoja.molex.cloud/docs/guides/modbus.html</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pamoja.Codec/Pamoja.Codec.csproj" />
    <ProjectReference Include="../Pamoja.Hal/Pamoja.Hal.csproj" />
    <ProjectReference Include="../Pamoja.Native/Pamoja.Native.csproj" />
  </ItemGroup>

</Project>
