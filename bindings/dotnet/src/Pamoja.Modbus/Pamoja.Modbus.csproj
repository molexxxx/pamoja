<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Pamoja.Modbus</PackageId>
    <AssemblyName>Pamoja.Modbus</AssemblyName>
    <RootNamespace>Pamoja.Modbus</RootNamespace>
    <Description>Modbus RTU requests and replies with CRC-16/MODBUS for RS485 field devices.</Description>
    <PackageTags>pamoja;iot;robotics;modbus</PackageTags>
    <PackageProjectUrl>https://pamoja.molex.cloud/docs/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pamoja.Codec/Pamoja.Codec.csproj" />
    <ProjectReference Include="../Pamoja.Native/Pamoja.Native.csproj" />
  </ItemGroup>

</Project>
