<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Pamoja.FieldIo</PackageId>
    <Description>Field I/O: The wires a gateway actually has: framed serial packets, an RS485 request and the reply it draws, a CAN frame, and the address a chip answers on.</Description>
    <PackageTags>pamoja;iot;robotics;field-io</PackageTags>
    <PackageProjectUrl>https://pamoja.molex.cloud/docs/install.html</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pamoja.Serial/Pamoja.Serial.csproj" />
    <ProjectReference Include="../Pamoja.Modbus/Pamoja.Modbus.csproj" />
    <ProjectReference Include="../Pamoja.Can/Pamoja.Can.csproj" />
    <ProjectReference Include="../Pamoja.Gpio/Pamoja.Gpio.csproj" />
  </ItemGroup>

</Project>
