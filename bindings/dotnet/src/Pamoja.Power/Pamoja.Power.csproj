<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Pamoja.Power</PackageId>
    <AssemblyName>Pamoja.Power</AssemblyName>
    <RootNamespace>Pamoja.Power</RootNamespace>
    <Description>Duty cycling and an energy-aware governor that stretches work as the battery drains.</Description>
    <PackageTags>pamoja;iot;robotics;power</PackageTags>
    <PackageProjectUrl>https://pamoja.molex.cloud/docs/guides/power.html</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pamoja.Native/Pamoja.Native.csproj" />
  </ItemGroup>

</Project>
