<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Pamoja.Security</PackageId>
    <AssemblyName>Pamoja.Security</AssemblyName>
    <RootNamespace>Pamoja.Security</RootNamespace>
    <Description>ed25519 device identity: sign a reading and verify it, so a gateway can prove it is authentic.</Description>
    <PackageTags>pamoja;iot;robotics;security</PackageTags>
    <PackageProjectUrl>https://pamoja.molex.cloud/docs/guides/security.html</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pamoja.Native/Pamoja.Native.csproj" />
  </ItemGroup>

</Project>
